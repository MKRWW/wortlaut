# wortlaut — Kopiervorlage fuer die .env des Betriebs (#92).
#
# DIESE DATEI ENTHAELT KEINE ECHTEN WERTE und darf nie welche enthalten.
# Kopie ausserhalb des Repos ablegen (z. B. /srv/wortlaut/.env), Rechte 600.
#
#   cp deploy/env.example /srv/wortlaut/.env && chmod 600 /srv/wortlaut/.env
#
# Variablennamen stammen aus den Settings-Klassen im Code; Defaults sind dort
# hinterlegt und hier als Kommentar vermerkt. Was einen Default hat, kann weg.

# --- Image ---------------------------------------------------------------
# Konkreter Commit-SHA, nie ein bewegliches Tag. Verfuegbare Tags:
# ghcr.io/mkrww/wortlaut  ->  <sha> (fest), develop und latest (wandern).
WORTLAUT_IMAGE_SHA=

# --- Datenbank -----------------------------------------------------------
# Zugangsdaten des Postgres-Containers.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=wortlaut

# Der DSN, den die Anwendung benutzt. Treiber MUSS asyncpg sein.
# Form: postgresql+asyncpg://<user>:<pass>@db:5432/<db>
WORTLAUT_DB_DSN=

# --- WORM-Speicher (Objektspeicher mit Object-Lock) ----------------------
# Host:Port OHNE Schema, z. B. worm:9000
WORTLAUT_WORM_ENDPOINT=worm:9000
WORTLAUT_WORM_ACCESS_KEY=
WORTLAUT_WORM_SECRET_KEY=
# Default: wortlaut-worm
WORTLAUT_WORM_BUCKET=wortlaut-worm
# TLS zum Objektspeicher. Im compose-internen Netz ohne TLS: false.
# Bei einem externen Objektspeicher: true.
WORTLAUT_WORM_SECURE=false

# --- Lese-API ------------------------------------------------------------
# Erlaubte Herkuenfte, KOMMAGETRENNT (nicht JSON). Die Liste ist VOLLSTAENDIG:
# wer sie setzt, muss die Produktionsdomain mit aufzaehlen, sonst sperrt er sie aus.
# Default wenn nicht gesetzt: https://wortlaut.io
WORTLAUT_API_CORS_ORIGINS=https://wortlaut.io
# Default 1. Jeder Worker haelt einen eigenen DB-Pool — max_connections beachten.
WORTLAUT_API_WORKERS=1
# Defaults: 0.0.0.0 und 8000. Im Container so lassen.
# WORTLAUT_API_HOST=0.0.0.0
# WORTLAUT_API_PORT=8000

# --- Tunnel --------------------------------------------------------------
TUNNEL_TOKEN=

# =========================================================================
# Ab hier nur fuer die Erfassungs-Laeufe noetig (ingest / timestamp).
# Der serve-Dienst braucht nichts davon.
# =========================================================================

# --- Quelle: DIP (Bundestag) ---------------------------------------------
WORTLAUT_DIP_API_KEY=
# Defaults sind gesetzt, nur bei Abweichung noetig:
# WORTLAUT_DIP_API_BASE_URL=https://search.dip.bundestag.de/api/v1
# WORTLAUT_DIP_PDF_HOST=dserver.bundestag.de

# --- Fremdarchivierung ---------------------------------------------------
# Internet-Archive-S3-Schlüssel (Save Page Now, #108): PFlichtfelder, leer hier.
# Erzeugen unter https://archive.org/account/s3.php (S3-Tab, "Show").
# Ein Lauf OHNE beide bricht früh mit Exit 2 ab (anonyme SPN2-Calls: 401);
# nur --dry-run kommt ohne.
WORTLAUT_ARCHIVE_IA_ACCESS_KEY=
WORTLAUT_ARCHIVE_IA_SECRET=
# SPN2-Polling: wie oft nach der Job-ID gefragt wird, und wie viele Versuche
# bevor ein Capture als Timeout gilt (permanent, kein Retry).
# WORTLAUT_ARCHIVE_SPN2_POLL_INTERVAL_SECONDS=3.0
# WORTLAUT_ARCHIVE_SPN2_POLL_TIMEOUT_SECONDS=180.0
# Rest mit Defaults belegt. Nur anfassen, wenn ein Lauf in Rate-Limits laeuft.
# SPN2 erlaubt authentifiziert 7 Captures/Minute — der Default 10 s bleibt darunter.
# WORTLAUT_ARCHIVE_WAYBACK_MIN_INTERVAL_SECONDS=10.0
# WORTLAUT_ARCHIVE_ARCHIVE_TODAY_MIN_INTERVAL_SECONDS=15.0
# WORTLAUT_ARCHIVE_RETRY_ATTEMPTS=3
# WORTLAUT_ARCHIVE_RETRY_BASE_DELAY_SECONDS=2.0
# Der Pre-Flight-Check prueft VOR dem Lauf, ob die Archivdienste antworten.
# Nur abschalten, wenn man weiss warum — er existiert, weil ein Vollbackfill
# schon einmal an einem Archiv-Ausfall gescheitert ist.
# WORTLAUT_ARCHIVE_PREFLIGHT_ENABLED=true

# --- Zeitstempel (RFC 3161) ----------------------------------------------
# WORTLAUT_TSA_PROFILES=freetsa,sigstore
# WORTLAUT_TSA_TIMEOUT_SECONDS=10.0
